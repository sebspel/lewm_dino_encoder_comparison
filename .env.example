# Runtime configuration. Copy to `.env` (gitignored) and fill in.
# Read once on `import src` (src/env.py); a variable already set in the real
# environment takes precedence over this file.

# Persistent network volume root: datasets, checkpoints, TensorRT engines and reports.
# REQUIRED — unset raises rather than silently falling back to ephemeral local paths.
# On the pod this is the mounted volume; off-pod (renders, tests) any writable path works.
STABLEWM_HOME=/workspace/.stablewm

# Weights & Biases. Without it training stalls on an interactive login prompt.
WANDB_API_KEY=

# Hugging Face. Needed for the gated DINOv3 backbone downloads (facebook/dinov3-*);
# the Push-T dataset is public and does not require it.
HF_TOKEN=
